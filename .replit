modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# As portas são as dos artifacts, e é o roteador quem decide o que vai para
# cada uma: `/` para a interface, `/api` para o api-server. Declará-las em
# 5000/5001, como estava aqui, subia a stack num endereço para onde o roteador
# não encaminha nada — o app abria e toda chamada de API voltava 502.
[[ports]]
localPort = 25609
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 3001

# O Run sobe os dois processos. Antes disto o `runButton` apontava para um
# workflow "Project" que não existia em lugar nenhum do repositório, então um
# workspace novo não subia nada e o que subia dependia de estado fora do git.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "API Server"

# Aplica migrations, reconstrói o bundle e sobe. Reconstrói de novo quando o
# código muda, para não voltar a existir um dist antigo servindo um frontend
# novo.
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/dev.mjs api"
waitForPort = 8080

[[workflows.workflow]]
name = "Frontend"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/dev.mjs web"
waitForPort = 25609

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
