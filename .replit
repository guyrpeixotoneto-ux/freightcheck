modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# A interface é a porta pública. O api-server fica atrás dela: o Vite encaminha
# `/api` para a 5001, como configurado em scripts/dev.mjs.
[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

# O Run sobe os dois processos. Antes disto o `runButton` apontava para um
# workflow "Project" que não existia em lugar nenhum do repositório, então um
# workspace novo não subia nada e o que subia dependia de estado fora do git.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "API Server"

# Aplica migrations, reconstrói o bundle e sobe. Reconstrói de novo quando o
# código muda, para não voltar a existir um dist antigo servindo um frontend
# novo.
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/dev.mjs api"
waitForPort = 5001

[[workflows.workflow]]
name = "Frontend"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/dev.mjs web"
waitForPort = 5000

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
