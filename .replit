modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# O Run precisa de um workflow. Não tinha nenhum, e por isso não subia nada.
#
# Os `.replit-artifact/artifact.toml` continuam sendo a fonte da verdade das
# portas e do deployment: é o `localPort` deles que o roteador usa, e é o
# `[services.production]` deles que a publicação executa. O que faltava era o
# gatilho: sem `[workflows]` e sem `runButton`, apertar Run não tinha o que
# iniciar. Observado no ambiente real — portas declaradas certas, `doctor`
# confirmando 8080 e 25609, e ninguém escutando em nenhuma das duas depois do
# Run; os mesmos comandos à mão sobem as duas.
#
# Isto não é uma stack paralela, e a diferença é a porta. O que existiu aqui
# antes subia os mesmos processos em 5000/5001 — endereços para onde o roteador
# não encaminha — e o efeito foi esconder um defeito: pela porta da stack
# paralela tudo respondia, e pela URL do app toda chamada de API voltava 502.
# As tasks abaixo rodam os mesmos comandos que os artifacts declaram em
# `[services.development]`, nas mesmas portas. Se algum dia o Replit passar a
# iniciar os services sozinho, os dois disputam a mesma porta e a colisão
# aparece na hora, em vez de virar uma segunda verdade silenciosa.
#
# `scripts/dev.mjs` é a implementação única: é o que estas tasks rodam, o que
# cada artifact roda, e o que `pnpm dev` roda fora do Replit e em CI.
#
# **As tasks tinham sumido, e o comentário acima continuou descrevendo-as.** A
# seção existia vazia — `[workflows]` sem `runButton` e sem nenhum
# `[[workflows.workflow]]` —, que é exatamente o estado que o primeiro parágrafo
# diz não subir nada. Um comentário que descreve um bloco ausente é pior do que
# nenhum: ele faz quem lê concluir que o Run está resolvido e procurar o defeito
# no código. Está reescrito abaixo, nas mesmas portas dos artifacts.

[workflows]
runButton = "FreightCheck"

[[workflows.workflow]]
name = "FreightCheck"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/dev.mjs api"
waitForPort = 8080

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/dev.mjs web"
waitForPort = 25609

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

# O post-merge instala e aplica migrations. 20s não davam conta: um merge que
# traz um pacote novo (o `@anthropic-ai/sdk` do Assistente, por exemplo) faz o
# install baixar antes de linkar, e o corte no meio deixa `node_modules` sem os
# symlinks de `@workspace/*` — estado em que o build para com
# `Could not resolve "@workspace/..."` e o código parece o culpado.
#
# O teto acima do necessário não custa nada quando não há o que instalar: o
# script termina em segundos e o timeout nem chega perto. Mesmo assim o Run não
# depende mais disto — `scripts/dev.mjs` instala antes de construir.
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
