modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# Não há workflow nem `[[ports]]` aqui, e é deliberado.
#
# Quem sobe este projeto são os services declarados nos
# `.replit-artifact/artifact.toml`, um por artifact — é para as portas deles que
# o roteador encaminha, e é o que o Run inicia. Um workflow paralelo subindo os
# mesmos processos por fora seria uma segunda stack, com duas portas próprias,
# dois builds do mesmo `dist` e duas migrations. Foi o que existiu aqui por um
# commit, e o efeito foi esconder um defeito em vez de mostrá-lo: pela porta da
# stack paralela tudo respondia, e pela URL do app toda chamada de API voltava
# 502. Uma forma só de subir, e ela é a que o usuário usa.
#
# `scripts/dev.mjs` continua sendo a implementação: é o que cada artifact roda
# em desenvolvimento, e `pnpm dev` é o mesmo script para fora do Replit e CI.

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
