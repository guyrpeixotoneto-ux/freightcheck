    "@workspace/comparison": "workspace:*",
    "@workspace/composition": "workspace:*",
    "@workspace/compras": "workspace:*",
    "@workspace/coverage": "workspace:*",
    "@workspace/curation": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/dre": "workspace:*",
    "@workspace/fechamento": "workspace:*",
    "@workspace/fluxos": "workspace:*",
    "@workspace/ingest": "workspace:*",
