{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "node scripts/dev.mjs",
    "dev:seed": "pnpm --filter @workspace/curation exec tsx src/cli/dev-seed.ts",
    "curar:direcao-economica-trecho": "pnpm --filter @workspace/curation exec tsx src/cli/curar-direcao-economica-trecho.ts",
    "test": "pnpm -r --if-present --no-sort run test",
    "test:limpar-templates": "pnpm --filter @workspace/db exec tsx ./src/limpar-templates-cli.ts",
    "normalizar:nome-gerencial": "pnpm --filter @workspace/curation exec tsx src/cli/normalizar-nome-gerencial.ts"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
